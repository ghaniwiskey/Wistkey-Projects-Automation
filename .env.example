# Copy to .env (gitignored). Variables are prefixed with each project's testIdPrefix (see projects/<slug>/project.yaml).

# scg-store
SCG_EMAIL=you@example.com
SCG_PASSWORD=your-password
# SCG_BASE_URL=https://scg.next.mystoreberry.com   # optional: override the env's baseUrl

# mha-spf (UAT account is passwordless: no SPF_*_PASS needed)
SPF_AGENCY_ADMIN_USER=SPF-A2216GA
# SPF_BASE_URL=https://mhauatweb.southeastasia.cloudapp.azure.com/

# Run every project against this env instead of its defaultEnv
# QA_ENV=staging
# More parallel workers (default 1, because projects may share test accounts)
# QA_WORKERS=2
