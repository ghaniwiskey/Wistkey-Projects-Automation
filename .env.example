# Template for .env (copy it to .env, which is gitignored; never commit real values).
# Variables are prefixed with each project's testIdPrefix (projects/<slug>/project.yaml).
# Test code never holds account data: logins come from here, everything else is read from the app.

# ===== storeberry-crm (Storeberry Flower CRM) =====
# Use the same test account in staging and production. Real values belong only in local .env.
SCRM_COMPANY=your-company
SCRM_USERNAME=your-username
SCRM_PASSWORD=your-password
# SCRM_BASE_URL=            # optional: override selected project's URL

# ===== storeberry-compare (Storeberry Flower customer storefront) =====
# Guest storefront checks use no credentials.
# SBF_BASE_URL=            # optional: override selected project's URL

# ===== scg-store (SCG online store) =====
SCG_EMAIL=you@example.com
SCG_PASSWORD=your-password
# SCG_BASE_URL=            # optional: override the env's baseUrl

# ===== mha-spf (MHA ATS UAT) =====
# The test account. Officer name and roles are read from the app, so another account or agency
# (e.g. HTA) only needs different values here. Tests whose role the account lacks are skipped.
SPF_USER=your-login-id
SPF_PASS=                  # empty: passwordless UAT account
# SPF_BASE_URL=            # optional: override the env's baseUrl

# ===== mha-hta (MHA ATS HTA UAT) =====
# The HTA test account (same rules as mha-spf: officer name and roles are read from the app).
HTA_USER=your-login-id
HTA_PASS=                  # empty: passwordless UAT account
# HTA_BASE_URL=             # optional: override the env's baseUrl

# ===== mha-mobile (MHA Mobile app) =====
# The mobile app account (native app on the emulator, tested with mobilewright).
# Mobile login = the account's full NRIC (MHA user manual); the UAT account is passwordless.
MHM_USER=your-login-id
MHM_PASS=                  # empty: passwordless UAT account
# MHA web account for the tests' web setup and checks (needs VET IC and LOGS1). Unset = the mha-spf account
# (SPF_USER / SPF_PASS).
# MHM_WEB_USER=
# MHM_WEB_PASS=
# HTA (QA_ENV=staging-hta): the phone user's Mobile Login ID (MHA web HTA > User Listing; UAT: passwordless).
# The web checks use the mha-hta account above (HTA_USER / HTA_PASS).
MHM_HTA_USER=your-mobile-login-id
MHM_HTA_PASS=
# MHM_MOBILECLI_PORT=13000 # optional: mobilecli's port (its default 12000 can sit in a Windows-reserved range)

# ===== Run options (all optional) =====
# QA_ENV=staging           # run every project against this env instead of its defaultEnv
# QA_WORKERS=1             # parallel workers (default 1: tests share accounts)
# QA_AUTH_MAX_AGE_MIN=30   # reuse a saved login session for this many minutes
