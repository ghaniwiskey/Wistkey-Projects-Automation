# Template for .env (copy it to .env, which is gitignored; never commit real values).
# Variables are prefixed with each project's testIdPrefix (projects/<slug>/project.yaml).
# Test code never holds account data: logins come from here, everything else is read from the app.

# ===== scg-store (SCG online store) =====
SCG_EMAIL=you@example.com
SCG_PASSWORD=your-password
# SCG_BASE_URL=            # optional: override the env's baseUrl

# ===== mha-spf (MHA ATS UAT) =====
# The test account. Officer name and roles are read from the app, so another account or agency
# (e.g. HTA) only needs different values here. Tests whose role the account lacks are skipped.
SPF_USER=your-login-id
SPF_PASS=                  # empty: passwordless UAT account
# SPF_BASE_URL=            # optional: override the env's baseUrl

# ===== Run options (all optional) =====
# QA_ENV=staging           # run every project against this env instead of its defaultEnv
# QA_WORKERS=1             # parallel workers (default 1: tests share accounts)
# QA_AUTH_MAX_AGE_MIN=30   # reuse a saved login session for this many minutes
